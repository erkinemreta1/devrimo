# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins the frontend is served from.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local/dev default is sqlite; point at Postgres in production, e.g.
# postgresql+asyncpg://devrimo:devrimo@localhost:5432/devrimo
DATABASE_URL=sqlite+aiosqlite:///./devrimo.db

# --- Auth (Supabase) ---
# Project ref, e.g. https://abcxyz.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Only needed if the project still issues legacy HS256 JWTs.
# Leave unset for projects using the asymmetric (ES256/RS256) signing keys,
# which are verified via SUPABASE_URL's JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# --- Agent runtime ---
# "docker" talks to a real Docker Engine; "fake" is an in-memory runtime
# used for local development and tests when no daemon is available.
AGENT_RUNTIME=docker
DOCKER_NETWORK=devrimo-agents
HERMES_IMAGE=devrimo/hermes:latest
AGENT_MEMORY_LIMIT=2g
AGENT_CPU_LIMIT=1.0
AGENT_PIDS_LIMIT=512
AGENT_IDLE_TIMEOUT_SECONDS=1800
AGENT_START_TIMEOUT_SECONDS=60
RECONCILE_INTERVAL_SECONDS=30

# --- Model provider forwarded into every agent container ---
AGENT_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=openrouter/free

# --- Campus MCP servers ---
# The four METU MCP servers are baked into the devrimo/hermes image, not
# configured here — see images/hermes/Dockerfile, whose build args pin each
# server's repo and ref. Per-student credentials are collected through
# onboarding and stored encrypted; nothing about them belongs in this file.

# --- Secrets ---
# Encrypts per-user Hermes API keys AND students' METU passwords at rest
# (Fernet, see app/core/crypto.py). Rotating this key without re-encrypting
# makes every stored campus connection undecryptable, and every student has to
# reconnect their METU account.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_ENCRYPTION_KEY=change-me-to-a-real-generated-secret
